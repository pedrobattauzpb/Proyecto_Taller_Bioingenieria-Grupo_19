# Protocolo de Inspección Digital de Gases Medicinales

## Configuración de Entorno

# Backend
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Protocolo de Inspección Digital de Gases Medicinales"

# Base de datos (Por defecto PostgreSQL en Docker, o SQLite en local)
# Para PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/gases_medicinales
# Para SQLite (desarrollo rápido sin docker): sqlite+aiosqlite:///./gases_medicinales.db
DATABASE_URL=sqlite+aiosqlite:///./gases_medicinales.db
SYNC_DATABASE_URL=sqlite:///./gases_medicinales.db

# Configuración PostgreSQL Docker
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gases_medicinales
POSTGRES_PORT=5432

# CORS (Orígenes permitidos para Frontend Web y Móvil)
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","http://127.0.0.1:8081","http://127.0.0.1:3000"]

# Almacenamiento de Evidencia Multimedia (Object Storage - MinIO / S3 / Local)
STORAGE_BACKEND=minio
STORAGE_LOCAL_DIR=./uploads/evidence

# MinIO (Desarrollo local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=gases-medicinales-evidence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# AWS S3 (Producción)
S3_BUCKET_NAME=gases-medicinales-evidence
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notificaciones y Alertas (OE-5)
ALERTS_ENABLED=True
ALERTS_SCHEDULER_ENABLED=True
ALERTS_SCHEDULER_INTERVAL_SECONDS=300
ALERTS_DISPATCH_SYNC=False
ALERTS_NOTIFY_CRITICAL_LIVE=True
ALERTS_DEFAULT_INSPECTION_INTERVAL_DAYS=90
ALERTS_DUE_SOON_DAYS=7
ALERTS_STALE_INSPECTION_HOURS=48
ALERTS_HYDRO_TEST_VALIDITY_YEARS=5
ALERTS_HYDRO_TEST_WARN_DAYS=60
ALERTS_RECURRENT_FAIL_THRESHOLD=3
ALERTS_RECURRENT_FAIL_WINDOW=5
ALERTS_MAX_SILENCE_HOURS=72
ALERTS_MAX_EXTERNAL_PER_HOUR=30
ALERTS_DIGEST_ENABLED=False
ALERTS_DIGEST_INTERVAL_MINUTES=60
FRONTEND_BASE_URL=http://localhost:5173

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM=GMAO Gases Medicinales <no-reply@hospital.local>

